# ═══════════════════════════════════════════════════════════════
#  META ADS DASHBOARD — Configuration
#  இங்கே உங்கள் credentials fill பண்ணு → server.js auto-connect ஆகும்!
# ═══════════════════════════════════════════════════════════════

# ─── Meta App Credentials ────────────────────────────────────
# எங்கே கிடைக்கும்: https://developers.facebook.com → My Apps → Settings → Basic
META_APP_ID=1461201592322096
META_APP_SECRET=your_meta_app_secret_here

# ─── Meta Access Token ───────────────────────────────────────
# எங்கே கிடைக்கும்: https://developers.facebook.com/tools/explorer/
# Permissions வேண்டும்: ads_read, ads_management, business_management
# (Long-lived: business.facebook.com → Settings → System Users → Generate Token)
META_ACCESS_TOKEN=your_meta_access_token_here

# ─── Ad Account ID ───────────────────────────────────────────
# எங்கே கிடைக்கும்: https://adsmanager.facebook.com → URL-ல் act= க்கு பிறகு number
# Example: act=1234567890 → இங்கே 1234567890 மட்டும் போடு (act_ வேண்டாம்)
META_AD_ACCOUNT_ID=your_ad_account_id_here

# ─── Google Sheets (Optional) ────────────────────────────────
# Sheet ID: https://docs.google.com/spreadsheets/d/THIS_IS_YOUR_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_CREDENTIALS_FILE=./credentials.json

# ─── Server Settings ─────────────────────────────────────────
PORT=4000
UPDATE_INTERVAL_SECONDS=900
DATE_PRESET=today
